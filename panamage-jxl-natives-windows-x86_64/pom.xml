<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>net.sourceforge.streamsupport</groupId>
		<artifactId>panamage</artifactId>
		<version>0.3.1-SNAPSHOT</version>
	</parent>

	<artifactId>panamage-jxl-natives-windows-x86_64</artifactId>
	<name>panamage-jxl-natives-windows-x86_64</name>
	<description>Native libjxl libraries for Windows x86_64</description>

	<!-- The native libraries are libjxl with skcms (BSD-3-Clause), Brotli (MIT) and Highway
	     (Apache-2.0 or BSD-3-Clause); the Java code is part of panamage (BSD-3-Clause).
	     The license texts are in META-INF/licenses of the JAR. -->
	<licenses>
		<license>
			<name>BSD-3-Clause</name>
			<url>https://spdx.org/licenses/BSD-3-Clause.html</url>
			<distribution>repo</distribution>
		</license>
		<license>
			<name>MIT</name>
			<url>https://spdx.org/licenses/MIT.html</url>
			<distribution>repo</distribution>
		</license>
		<license>
			<name>Apache-2.0</name>
			<url>https://spdx.org/licenses/Apache-2.0.html</url>
			<distribution>repo</distribution>
		</license>
	</licenses>

	<properties>
		<!-- The bundle class needs nothing newer, so that panamage-jxl-jdk21 can use it too. -->
		<maven.compiler.release>21</maven.compiler.release>
		<!-- Source of the libjxl runtime DLLs and their location inside the JAR. -->
		<natives.bin.dir>${jxl.native.windows.dir}/bin</natives.bin.dir>
		<natives.target.dir>${project.build.outputDirectory}/panamage/jxl/natives/windows/x86_64</natives.target.dir>
	</properties>

	<dependencies>
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>panamage-jxl-spi</artifactId>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<resources>
			<resource>
				<directory>src/main/resources</directory>
				<filtering>true</filtering>
			</resource>
		</resources>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-enforcer-plugin</artifactId>
				<executions>
					<execution>
						<id>require-native-libraries</id>
						<goals>
							<goal>enforce</goal>
						</goals>
						<configuration>
							<rules>
								<requireFilesExist>
									<message>The libjxl DLLs for Windows were not found. They are checked in under natives/ (see natives/README.md); set -Djxl.native.windows.dir if they are elsewhere.</message>
									<files>
										<file>${natives.bin.dir}/brotlicommon.dll</file>
										<file>${natives.bin.dir}/brotlidec.dll</file>
										<file>${natives.bin.dir}/brotlienc.dll</file>
										<file>${natives.bin.dir}/jxl_cms.dll</file>
										<file>${natives.bin.dir}/jxl.dll</file>
										<file>${natives.bin.dir}/jxl_threads.dll</file>
									</files>
								</requireFilesExist>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-resources-plugin</artifactId>
				<executions>
					<execution>
						<id>copy-native-libraries</id>
						<phase>generate-resources</phase>
						<goals>
							<goal>copy-resources</goal>
						</goals>
						<configuration>
							<outputDirectory>${natives.target.dir}</outputDirectory>
							<resources>
								<resource>
									<directory>${natives.bin.dir}</directory>
									<filtering>false</filtering>
									<includes>
										<include>brotlicommon.dll</include>
										<include>brotlidec.dll</include>
										<include>brotlienc.dll</include>
										<include>jxl_cms.dll</include>
										<include>jxl.dll</include>
										<include>jxl_threads.dll</include>
									</includes>
								</resource>
							</resources>
						</configuration>
					</execution>
					<execution>
						<id>copy-licenses</id>
						<phase>generate-resources</phase>
						<goals>
							<goal>copy-resources</goal>
						</goals>
						<configuration>
							<outputDirectory>${project.build.outputDirectory}/META-INF/licenses</outputDirectory>
							<resources>
								<resource>
									<directory>${jxl.native.windows.dir}/licenses</directory>
									<filtering>false</filtering>
									<includes>
										<include>LICENSE.libjxl</include>
										<include>LICENSE.brotli</include>
										<include>LICENSE.highway</include>
										<include>LICENSE.skcms</include>
									</includes>
								</resource>
							</resources>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
