<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>net.sourceforge.streamsupport</groupId>
		<artifactId>panamage</artifactId>
		<version>0.2.1-SNAPSHOT</version>
	</parent>

	<artifactId>panamage-jxl-imageio</artifactId>
	<name>panamage-jxl-imageio</name>
	<description>Java Image I/O plugin for JPEG XL, based on panamage-jxl</description>

	<dependencies>
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>panamage-jxl</artifactId>
		</dependency>
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>panamage-jxl-natives-windows-x86_64</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>panamage-jxl-natives-linux-x86_64</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>panamage-jxl-natives-linux-aarch64</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>panamage-jxl-natives-linux-musl-x86_64</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>panamage-jxl-natives-linux-musl-aarch64</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>panamage-jxl-natives-macos-aarch64</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<testResources>
			<testResource>
				<directory>src/test/resources</directory>
			</testResource>
			<!-- Share the test images of the codec module instead of copying them. -->
			<testResource>
				<directory>../panamage-jxl/src/test/resources</directory>
			</testResource>
		</testResources>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<executions>
					<!-- The Image I/O service providers are loaded by every JVM that has this JAR on
					     the class path. Compiled for Java 8, they can be loaded by older JVMs as well
					     and deregister themselves there, instead of breaking Image I/O for all
					     formats. This execution overwrites their class files from default-compile. -->
					<execution>
						<id>compile-service-providers</id>
						<phase>compile</phase>
						<goals>
							<goal>compile</goal>
						</goals>
						<configuration>
							<release>8</release>
							<includes>
								<include>panamage/jxl/imageio/JxlFormat.java</include>
								<include>panamage/jxl/imageio/JxlImageReaderSpi.java</include>
								<include>panamage/jxl/imageio/JxlImageWriterSpi.java</include>
							</includes>
							<compilerArgs>
								<arg>-Xlint:-options</arg>
							</compilerArgs>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<configuration>
					<archive>
						<manifest>
							<addDefaultImplementationEntries>true</addDefaultImplementationEntries>
						</manifest>
					</archive>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<!-- Fail fast instead of blocking the build if a native call loops. -->
					<forkedProcessTimeoutInSeconds>300</forkedProcessTimeoutInSeconds>
					<argLine>--enable-native-access=panamage.jxl,ALL-UNNAMED</argLine>
					<systemPropertyVariables>
						<panamage.jxl.cache.dir>${project.build.directory}/native-cache</panamage.jxl.cache.dir>
						<panamage.jxl.conformance.dir>${conformance.dir}</panamage.jxl.conformance.dir>
						<jdk8.home>${jdk8.home}</jdk8.home>
						<jdk21.home>${jdk21.home}</jdk21.home>
					</systemPropertyVariables>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
