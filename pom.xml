<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd"
	child.project.url.inherit.append.path="false">
	<modelVersion>4.0.0</modelVersion>
	<groupId>net.sourceforge.streamsupport</groupId>
	<artifactId>panamage</artifactId>
	<version>0.1.1-SNAPSHOT</version>
	<packaging>pom</packaging>

	<name>panamage</name>
	<description>JPEG XL for Java, based on libjxl and the Foreign Function and Memory API</description>
	<url>https://github.com/stefan-zobel/panamage</url>
	<inceptionYear>2026</inceptionYear>

	<licenses>
		<license>
			<name>BSD-3-Clause</name>
			<url>https://spdx.org/licenses/BSD-3-Clause.html</url>
			<distribution>repo</distribution>
		</license>
	</licenses>

	<developers>
		<developer>
			<id>stefan-zobel</id>
			<name>Stefan Zobel</name>
			<url>https://github.com/stefan-zobel</url>
		</developer>
	</developers>

	<!-- The modules share the repository, so the URLs are inherited without appending the artifactId. -->
	<scm child.scm.connection.inherit.append.path="false"
		child.scm.developerConnection.inherit.append.path="false"
		child.scm.url.inherit.append.path="false">
		<connection>scm:git:https://github.com/stefan-zobel/panamage.git</connection>
		<developerConnection>scm:git:ssh://git@github.com/stefan-zobel/panamage.git</developerConnection>
		<url>https://github.com/stefan-zobel/panamage</url>
		<tag>HEAD</tag>
	</scm>

	<issueManagement>
		<system>GitHub Issues</system>
		<url>https://github.com/stefan-zobel/panamage/issues</url>
	</issueManagement>

	<modules>
		<module>panamage-jxl-spi</module>
		<module>panamage-jxl-natives-windows-x86_64</module>
		<module>panamage-jxl-natives-linux-x86_64</module>
		<module>panamage-jxl-natives-linux-aarch64</module>
		<module>panamage-jxl-natives-linux-musl-x86_64</module>
		<module>panamage-jxl-natives-linux-musl-aarch64</module>
		<module>panamage-jxl-natives-macos-aarch64</module>
		<module>panamage-jxl</module>
		<module>panamage-jxl-imageio</module>
	</modules>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<maven.compiler.release>25</maven.compiler.release>
		<!-- The JDK that compiles and tests. It can be newer than the release: panamage-jxl-spi and
		     the native bundles are compiled for release 21 with it, so that panamage-jxl-jdk21 can
		     use them too. -->
		<toolchain.jdk.version>25</toolchain.jdk.version>
		<!-- Directory with the external tools, see scripts/fetch_tools.py: .tools in the
		     project by default, or the PANAMAGE_TOOLS_DIR environment variable, or -Dtools.dir=... -->
		<tools.dir>${maven.multiModuleProjectDirectory}/.tools</tools.dir>
		<!-- libjxl and Brotli DLLs for Windows x86_64 (bin, licenses), checked in because the DLLs of
		     the libjxl release need a newer C++ runtime than some JDKs ship; these are built with
		     the static runtime. See natives/README.md. -->
		<jxl.native.windows.dir>${maven.multiModuleProjectDirectory}/natives/libjxl-0.12.0-windows-x86_64</jxl.native.windows.dir>
		<!-- libjxl and Brotli shared libraries for Linux x86_64 (lib, licenses). -->
		<jxl.native.linux.dir>${tools.dir}/libjxl-0.12.0-linux-x86_64</jxl.native.linux.dir>
		<!-- libjxl and Brotli shared libraries for Linux aarch64 (lib, licenses), checked in because
		     libjxl publishes no binaries for 64-bit ARM; see natives/README.md. -->
		<jxl.native.linux.aarch64.dir>${maven.multiModuleProjectDirectory}/natives/libjxl-0.12.0-linux-aarch64</jxl.native.linux.aarch64.dir>
		<!-- libjxl and Brotli shared libraries for musl-based Linux x86_64 (lib, licenses), checked in
		     because libjxl publishes no binaries for musl; see natives/README.md. -->
		<jxl.native.linux.musl.x86_64.dir>${maven.multiModuleProjectDirectory}/natives/libjxl-0.12.0-linux-musl-x86_64</jxl.native.linux.musl.x86_64.dir>
		<!-- libjxl and Brotli shared libraries for musl-based Linux aarch64 (lib, licenses), checked in
		     because libjxl publishes no binaries for musl; see natives/README.md. -->
		<jxl.native.linux.musl.aarch64.dir>${maven.multiModuleProjectDirectory}/natives/libjxl-0.12.0-linux-musl-aarch64</jxl.native.linux.musl.aarch64.dir>
		<!-- libjxl and Brotli shared libraries for macOS arm64 (lib, licenses), checked in because
		     libjxl publishes no macOS binaries; see natives/README.md. -->
		<jxl.native.macos.dir>${maven.multiModuleProjectDirectory}/natives/libjxl-0.12.0-macos-aarch64</jxl.native.macos.dir>
		<!-- Test cases of the JPEG XL conformance corpus; the conformance tests are skipped without them. -->
		<conformance.dir>${tools.dir}/conformance-b1d0f99</conformance.dir>
		<libjxl.version>0.12.0</libjxl.version>
		<junit.version>6.1.3</junit.version>
		<!-- Fixed time stamp of the files in the JARs, so that builds of the same sources are
		     byte-identical (reproducible builds). -->
		<project.build.outputTimestamp>2026-10-01T00:00:00Z</project.build.outputTimestamp>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>${project.groupId}</groupId>
				<artifactId>panamage-jxl-spi</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>${project.groupId}</groupId>
				<artifactId>panamage-jxl-natives-windows-x86_64</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>${project.groupId}</groupId>
				<artifactId>panamage-jxl-natives-linux-x86_64</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>${project.groupId}</groupId>
				<artifactId>panamage-jxl-natives-linux-aarch64</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>${project.groupId}</groupId>
				<artifactId>panamage-jxl-natives-linux-musl-x86_64</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>${project.groupId}</groupId>
				<artifactId>panamage-jxl-natives-linux-musl-aarch64</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>${project.groupId}</groupId>
				<artifactId>panamage-jxl-natives-macos-aarch64</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>${project.groupId}</groupId>
				<artifactId>panamage-jxl</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>org.junit</groupId>
				<artifactId>junit-bom</artifactId>
				<version>${junit.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<build>
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-compiler-plugin</artifactId>
					<version>3.16.0</version>
					<configuration>
						<release>${maven.compiler.release}</release>
					</configuration>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-surefire-plugin</artifactId>
					<version>3.6.0</version>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-toolchains-plugin</artifactId>
					<version>3.3.0</version>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-enforcer-plugin</artifactId>
					<version>3.6.3</version>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-resources-plugin</artifactId>
					<version>3.5.0</version>
					<configuration>
						<propertiesEncoding>UTF-8</propertiesEncoding>
					</configuration>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-jar-plugin</artifactId>
					<version>3.5.1</version>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-source-plugin</artifactId>
					<version>3.4.0</version>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-javadoc-plugin</artifactId>
					<version>3.12.0</version>
				</plugin>
				<plugin>
					<groupId>org.codehaus.mojo</groupId>
					<artifactId>exec-maven-plugin</artifactId>
					<version>3.6.4</version>
				</plugin>
			</plugins>
		</pluginManagement>
		<plugins>
			<!-- Build with the JDK 25 toolchain from ~/.m2/toolchains.xml,
			     independent of the JDK that runs Maven itself. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-toolchains-plugin</artifactId>
				<executions>
					<execution>
						<goals>
							<goal>toolchain</goal>
						</goals>
					</execution>
				</executions>
				<configuration>
					<toolchains>
						<jdk>
							<version>${toolchain.jdk.version}</version>
						</jdk>
					</toolchains>
				</configuration>
			</plugin>
			<!-- Sources and Javadoc JARs, required by Maven Central. They are built on every
			     verify, so that Javadoc errors show up early. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-source-plugin</artifactId>
				<executions>
					<execution>
						<id>attach-sources</id>
						<goals>
							<goal>jar-no-fork</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-javadoc-plugin</artifactId>
				<executions>
					<execution>
						<id>attach-javadocs</id>
						<goals>
							<goal>jar</goal>
						</goals>
					</execution>
				</executions>
				<configuration>
					<doclint>all,-missing</doclint>
					<failOnWarnings>true</failOnWarnings>
					<notimestamp>true</notimestamp>
					<quiet>true</quiet>
					<!-- The web fonts would add about 4 MB to every Javadoc JAR. -->
					<additionalOptions>
						<additionalOption>--no-fonts</additionalOption>
					</additionalOptions>
				</configuration>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<!-- panamage-jxl-jdk21 needs a JDK 21 toolchain and Python, so it is built only on request. -->
		<profile>
			<id>jdk21</id>
			<modules>
				<module>panamage-jxl-jdk21</module>
			</modules>
		</profile>
		<profile>
			<id>tools-dir-from-env</id>
			<activation>
				<property>
					<name>env.PANAMAGE_TOOLS_DIR</name>
				</property>
			</activation>
			<properties>
				<tools.dir>${env.PANAMAGE_TOOLS_DIR}</tools.dir>
			</properties>
		</profile>
	</profiles>
</project>
