<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>net.sourceforge.streamsupport</groupId>
		<artifactId>panamage</artifactId>
		<version>0.2.0</version>
	</parent>

	<artifactId>panamage-jxl</artifactId>
	<name>panamage-jxl</name>
	<description>JPEG XL for Java, based on libjxl and the Foreign Function and Memory API</description>

	<properties>
		<!-- Set with -Dpanamage.jxl.library.path=<dir> to test loading from a directory. -->
		<panamage.jxl.library.path></panamage.jxl.library.path>
	</properties>

	<dependencies>
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>panamage-jxl-spi</artifactId>
		</dependency>
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>panamage-jxl-natives-windows-x86_64</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>panamage-jxl-natives-linux-x86_64</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>panamage-jxl-natives-linux-aarch64</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>panamage-jxl-natives-linux-musl-x86_64</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>panamage-jxl-natives-linux-musl-aarch64</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>panamage-jxl-natives-macos-aarch64</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<!-- Fail fast instead of blocking the build if a native call loops. -->
					<forkedProcessTimeoutInSeconds>300</forkedProcessTimeoutInSeconds>
					<argLine>--enable-native-access=panamage.jxl,ALL-UNNAMED</argLine>
					<systemPropertyVariables>
						<!-- Keep extracted libraries out of the global temp directory. -->
						<panamage.jxl.cache.dir>${project.build.directory}/native-cache</panamage.jxl.cache.dir>
						<panamage.jxl.library.path>${panamage.jxl.library.path}</panamage.jxl.library.path>
						<panamage.jxl.conformance.dir>${conformance.dir}</panamage.jxl.conformance.dir>
					</systemPropertyVariables>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
